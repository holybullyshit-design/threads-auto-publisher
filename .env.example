# ==========================================================
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 있어 커밋되지 않고,
# 서버 코드(서버 밖/프론트엔드)로도 절대 전송되지 않습니다.
#
# Threads 계정(여러 개) 자체는 .env가 아니라 앱의 "계정 관리" 화면에서
# 등록합니다 -> data/accounts.json에 저장됩니다 (역시 git에 커밋되지 않음).
# ==========================================================

# --- Anthropic Claude API ---
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# 초안/톤 변환에 사용할 모델 (기본값 그대로 두셔도 됩니다)
ANTHROPIC_MODEL=claude-sonnet-5

# --- 클라우드 예약 발행 (GitHub) ---
# 랩톱이 꺼져 있어도 예약된 시간에 자동 게시되도록, 예약 목록을
# GitHub 저장소(schedule/posts.json)에 저장하고 GitHub Actions가 대신 게시합니다.
# README의 "클라우드 예약 발행 설정" 섹션을 따라 값을 채워주세요.

# 저장소 형식: "내깃헙아이디/저장소이름"
GITHUB_REPO=

# 해당 저장소에 대한 Fine-grained PAT (Contents: Read and write 권한만 있으면 됩니다)
# https://github.com/settings/personal-access-tokens/new 에서 발급
GITHUB_TOKEN=

# --- 로컬 서버 ---
PORT=4321
