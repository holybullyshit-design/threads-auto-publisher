# ==========================================================
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 있어 커밋되지 않고,
# 서버 코드(서버 밖/프론트엔드)로도 절대 전송되지 않습니다.
#
# Threads 계정(여러 개) 자체는 .env가 아니라 앱의 "계정 관리" 화면에서
# 등록합니다 -> data/accounts.json에 저장됩니다 (역시 git에 커밋되지 않음).
# ==========================================================

# 초안 생성 / 톤 다듬기는 Anthropic API 키가 아니라, 이 컴퓨터에 로그인된
# Claude Code CLI(`claude` 명령어)를 그대로 사용합니다. 별도 키 설정이 필요 없습니다.
# (터미널에서 `claude auth status`로 로그인 상태를 확인할 수 있습니다)

# --- Threads 계정 자동 연결 (OAuth) ---
# https://developers.facebook.com/apps 에서 만든 앱의 "Threads" 사용 사례 설정에서 확인
# (계정 관리 탭의 "Threads 계정 자동 연결" 버튼에 사용됩니다)
THREADS_APP_ID=
THREADS_APP_SECRET=
# 앱 설정의 "Redirect URIs"에 아래 주소를 그대로 등록해주세요 (PORT를 바꿨다면 포트 번호도 맞춰주세요)
THREADS_REDIRECT_URI=http://localhost:4321/oauth/threads/callback

# --- 클라우드 예약 발행 (GitHub) ---
# 랩톱이 꺼져 있어도 예약된 시간에 자동 게시되도록, 예약 목록을
# GitHub 저장소(schedule/posts.json)에 저장하고 GitHub Actions가 대신 게시합니다.
# README의 "클라우드 예약 발행 설정" 섹션을 따라 값을 채워주세요.

# 저장소 형식: "내깃헙아이디/저장소이름"
GITHUB_REPO=

# 해당 저장소에 대한 Fine-grained PAT (Contents: Read and write 권한만 있으면 됩니다)
# https://github.com/settings/personal-access-tokens/new 에서 발급
GITHUB_TOKEN=

# --- 다른 사이트에서 상품 사진 찾기 (구글 Custom Search 이미지 검색) ---
# 파트너스: 쿠팡 외 다른 곳에서 같은 상품의 사진 후보를 찾아 보여주고, 직접 골라서 쓰는 기능.
# (원래 네이버쇼핑 검색 API로 만들었었는데, 2026-07-31부로 그 API 자체가 완전 폐지되어 교체함)
# 1) https://console.cloud.google.com/apis/library/customsearch.googleapis.com 에서
#    "Custom Search API" 사용 설정 후 API 키 발급 -> GOOGLE_CSE_API_KEY
# 2) https://programmablesearchengine.google.com/controlpanel/all 에서 검색엔진 만들기
#    -> "전체 웹 검색"으로 설정 -> 설정에서 "이미지 검색" 켜기 -> 검색엔진 ID 복사 -> GOOGLE_CSE_CX
# 무료 티어: 하루 100건. 설정 안 해도 앱은 정상 동작하고, "다른 사이트에서 사진 찾기" 버튼만 안 보입니다.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- 쿠팡파트너스 상품 검색 (Open API) ---
# 파트너스: 키워드로 쿠팡 상품을 검색해서 공식 이미지/상품명/가격/제휴 추적 코드가 박힌
# 구매 링크를 한 번에 가져오는 기능. https://partners.coupang.com 가입 후
# "Open API" 메뉴에서 발급받습니다. 설정 안 해도 앱은 정상 동작하고, 쿠팡 상품 검색 기능만 안 보입니다.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# --- 파트너스 상품 사진 자연스럽게 편집 (OpenAI 이미지 편집) ---
# 쿠팡 공식 스튜디오컷을 "실제 사람이 쓰는/먹는 순간을 찍은" 것처럼 편집하는 기능.
# https://platform.openai.com/api-keys 에서 발급 (ChatGPT 구독과는 별개로 발급받아야 합니다).
# 설정 안 해도 앱은 정상 동작하고, 이 편집 단계만 건너뛰고 원본 쿠팡 이미지를 그대로 씁니다.
OPENAI_API_KEY=

# --- 로컬 서버 ---
PORT=4321
